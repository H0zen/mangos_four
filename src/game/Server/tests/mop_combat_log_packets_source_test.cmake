    message(FATAL_ERROR "damage-shield serializer is absent from the owning spell code")
endif()
if(NOT melee_damage_cpp MATCHES "MopCombatLogPackets::BuildSpellDamageShieldLog" OR
   NOT melee_damage_cpp MATCHES "SMSG_SPELLDAMAGESHIELD")
    message(FATAL_ERROR "damage-shield sender bypasses the 18414 serializer")
endif()
