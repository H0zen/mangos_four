if(NOT spell_h MATCHES "BuildSpellMissLog" OR
   NOT spell_h MATCHES "out.WriteBits\\(uint32\\(log.targetCount\\), 23\\)" OR
   NOT spell_h MATCHES "log.targetCount >= \\(size_t\\(1\\) << 23\\)")
    message(FATAL_ERROR "spell-miss serializer or its 23-bit count contract is absent")
endif()
if(NOT unit_cpp MATCHES "MopCombatLogPackets::BuildSpellMissLog" OR
   NOT unit_cpp MATCHES "SMSG_SPELLLOGMISS")
    message(FATAL_ERROR "spell-miss sender bypasses the 18414 serializer")
endif()
