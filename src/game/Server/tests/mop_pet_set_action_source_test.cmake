set(mutation_applied FALSE)
macro(mutate var old new)
    string(FIND "${${var}}" "${old}" mutation_at)
    if(NOT mutation_at EQUAL -1)
        string(REPLACE "${old}" "${new}" ${var} "${${var}}")
        set(mutation_applied TRUE)
    endif()
endmacro()

