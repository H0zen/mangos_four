function(require_once source token context)
    # CMake lists use semicolons as separators. Replace them before MATCHALL so
    # one source match ending in ';' is counted as one match rather than two
    # list elements.
    string(REPLACE ";" "__MOP_SEMICOLON__" match_source "${source}")
    string(REPLACE ";" "__MOP_SEMICOLON__" match_token "${token}")
    string(REGEX MATCHALL "${match_token}" matches "${match_source}")
    list(LENGTH matches count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "${context}: expected once, found ${count}")
    endif()
endfunction()

function(require_absent source token context)
    string(FIND "${source}" "${token}" found)
    if(NOT found EQUAL -1)
        message(FATAL_ERROR "${context}: forbidden token present")
    endif()
endfunction()

